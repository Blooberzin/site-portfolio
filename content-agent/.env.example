# Acesso privado ao Content OS
CONTENT_OS_USER=
CONTENT_OS_PASSCODE=
# Gere um segredo aleatório longo (ex.: openssl rand -hex 32)
CONTENT_OS_SESSION_SECRET=

# IA — Vercel AI Gateway
AI_MODEL=openai/gpt-5.4
# Em produção na Vercel, prefira OIDC. Alternativa para ambientes externos:
# AI_GATEWAY_API_KEY=

# Publicação do artigo via Pull Request
GITHUB_TOKEN=
GITHUB_REPO=barbosarenan/site-portfolio
GITHUB_BASE_BRANCH=main

# Agendamento social via Metricool REST API
# Disponível para contas Metricool com acesso à API.
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
METRICOOL_TIMEZONE=America/Sao_Paulo
