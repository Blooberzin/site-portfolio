---
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import { perfil, servicos } from "../dados/perfil";
---
<Base
  titulo={"Serviços · " + perfil.nome}
  descricao="Projetos de SEO, conteúdo e experimentação com IA para operações enxutas."
>
  <section class="env abertura">
    <p class="rotulo">05 · serviços</p>
    <h1 class="linha-um">Projetos pequenos. Problemas concretos.</h1>
    <p class="resumo">
      Atendo projetos pontuais fora do horário comercial, com escopo claro,
      entrega objetiva e sem promessa de “solução 360°” para quem só precisa
      de uma coisa bem resolvida.
    </p>
  </section>

  <section class="env secao forte">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">o que eu entrego</span>
        <p>Escopo fechado e linguagem sem enrolação.</p>
      </div>

      <div class="itens">
        {servicos.map((s) => (
          <article class="item">
            <h2>{s.titulo}</h2>
            <p class="rotulo entrega">{s.entrega}</p>
            <p>{s.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Chamada titulo="Me conte o que você precisa resolver." />
</Base>
