---
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import { perfil, servicos } from "../dados/perfil";
---
<Base
  titulo={"Serviços · " + perfil.nome}
  descricao="Projetos de SEO, conteúdo e experimentação com IA para operações enxutas."
>
  <section class="env abertura">
    <span class="rotulo">05 · serviços</span>
    <h1 class="linha-um">Projetos pequenos. Problemas concretos.</h1>
    <p class="resumo">Escopo claro, entrega objetiva e foco no que realmente precisa ser resolvido.</p>
  </section>

  <section class="env secao">
    <div class="cards-grid three">
      {servicos.map((s, i) => (
        <article class="project-card">
          <div class="project-top">
            <span class="project-number">{String(i + 1).padStart(2, "0")}</span>
            <span class="project-tag">{s.entrega}</span>
          </div>
          <h3>{s.titulo}</h3>
          <p>{s.texto}</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>

  <section class="env secao">
    <div class="section-head">
      <div>
        <span class="rotulo">formato</span>
        <h2 class="section-title">Direto ao problema.</h2>
      </div>
      <p>Projetos pontuais, com escopo definido e comunicação simples.</p>
    </div>
    <div class="stack-list">
      <span class="stack-chip">escopo fechado</span>
      <span class="stack-chip">entrega objetiva</span>
      <span class="stack-chip">prioridades claras</span>
      <span class="stack-chip">sem pacote genérico</span>
    </div>
  </section>

  <Chamada titulo="Me conte o que você precisa resolver." />
</Base>
