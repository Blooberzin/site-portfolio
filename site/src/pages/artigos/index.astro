---
import Base from "../../layouts/Base.astro";
import { perfil } from "../../dados/perfil";
import { getCollection } from "astro:content";

const artigos = (await getCollection("artigos", ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data - a.data.data);
const fmt = (d) => d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });
---
<Base titulo={`Artigos · ${perfil.nome}`} descricao="Método, teste e o que não funcionou. Sobre SEO, conteúdo e IA aplicada ao trabalho real.">
  <section class="env abertura">
    <p class="rotulo">04 · artigos</p>
    <h1 class="linha-um">O que eu testei e o que sobrou.</h1>
    <p class="resumo">
      A versão longa do que eu publico no <a href={perfil.instagram} rel="noopener">testeiaqui.py</a>.
      Aqui cabe o método inteiro, com o que deu errado junto.
    </p>
  </section>

  <section class="env secao forte">
    <div class="lista-artigos">
      {artigos.map((a) => (
        <article class="artigo-linha">
          <time datetime={a.data.data.toISOString()}>{fmt(a.data.data)}</time>
          <div>
            <a href={`/artigos/${a.id}/`}>
              <h3>{a.data.titulo}</h3>
              <p>{a.data.resumo}</p>
            </a>
            {a.data.tags.length > 0 && (
              <div class="tags">{a.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
