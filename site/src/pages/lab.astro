---
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import { perfil, lab } from "../dados/perfil";
---
<Base
  titulo={"AI Lab · " + perfil.nome}
  descricao="Laboratório de experimentação com IA generativa, automação, agentes e produtos digitais."
>
  <section class="env abertura">
    <span class="rotulo">04 · ai lab</span>
    <h1 class="linha-um">Eu testo a tecnologia no trabalho real.</h1>
    <p class="resumo">Protótipos, fluxos e ideias em evolução. Nem tudo vira produto — mas tudo precisa ensinar alguma coisa.</p>
  </section>

  <section class="env secao">
    <div class="cards-grid">
      {lab.map((item, i) => (
        <article class:list={["project-card", i === 0 ? "large" : ""]}>
          <div class="project-top">
            <span class="project-number">{String(i + 1).padStart(2, "0")}</span>
            <span class="project-tag">{item.stack}</span>
          </div>
          <h3>{item.titulo}</h3>
          <p>{item.texto}</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>

  <Chamada titulo="Tenho uma ideia que vale testar." />
</Base>
