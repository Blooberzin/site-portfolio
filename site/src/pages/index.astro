---
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import { perfil, pilares, casos } from "../dados/perfil";
import { getCollection } from "astro:content";

const artigos = (await getCollection("artigos", ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data - a.data.data)
  .slice(0, 3);

const fmt = (d) =>
  d.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
---
<Base titulo={perfil.nome + " · marketing, tecnologia e IA"}>
  <section class="env hero">
    <div class="hero-copy">
      <span class="rotulo">marketing · tecnologia · IA</span>
      <h1 class="linha-um">Estratégia de marketing conectada a dados, tecnologia e IA.</h1>
      <p class="hero-sub">
        Atuo com SEO, conteúdo, estratégia digital e inteligência artificial aplicada, conectando diferentes disciplinas para transformar desafios de marketing em soluções relevantes para o negócio.
      </p>

      <div class="hero-acoes" aria-label="Ações principais">
        <a class="botao" href="#trabalhos">conhecer projetos</a>
        <a class="botao vazado" href="/sobre/">sobre mim</a>
      </div>
    </div>

    <aside class="hero-note" aria-label="Resumo profissional">
      <div class="note-line">
        <span>perfil</span>
        <span class="note-dot" aria-hidden="true"></span>
      </div>
      <strong>{perfil.cargo}</strong>
      <p>{perfil.local}</p>
      <p>SEO · conteúdo · IA generativa · web</p>
    </aside>
  </section>

  <section class="env secao">
    <div class="section-head">
      <div>
        <h2 class="section-title">Áreas de atuação</h2>
      </div>
      <p>Minha experiência combina marketing e repertório técnico para analisar problemas sob diferentes perspectivas e desenvolver soluções mais completas.</p>
    </div>

    <div class="proof-grid">
      <div class="proof-item"><strong>SEO</strong><span>estratégia de busca, análise de oportunidades, arquitetura de conteúdo e otimização orientada por dados.</span></div>
      <div class="proof-item"><strong>Conteúdo</strong><span>Planejamento e desenvolvimento de conteúdo alinhado à intenção de busca, objetivos de comunicação e prioridades de negócio.</span></div>
      <div class="proof-item"><strong>IA aplicada</strong><span>experimentação com LLMs, agentes e automações aplicadas a processos de marketing, conteúdo e análise.</span></div>
      <div class="proof-item"><strong>Web</strong><span>Desenvolvimento e evolução de experiências digitais, incluindo sites, protótipos e integrações.</span></div>
    </div>
  </section>

  <section class="env secao" id="trabalhos">
    <div class="section-head">
      <div>
        <span class="rotulo">01 · projetos</span>
        <h2 class="section-title">Trabalho que mostra como eu penso.</h2>
      </div>
      <p>Menos lista de tarefas. Mais contexto, decisão e construção.</p>
    </div>

    <div class="cards-grid">
      {casos.map((c, i) => (
        <article class:list={["project-card", i === 0 || i === 3 ? "large" : ""]}>
          <div class="project-top">
            <span class="project-number">{String(i + 1).padStart(2, "0")}</span>
            <span class="project-tag">{c.categoria}</span>
          </div>
          <h3>{c.titulo}</h3>
          <p>{c.papel}</p>
          <p>{c.texto}</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>

  <section class="env secao">
    <div class="section-head">
      <div>
        <span class="rotulo">02 · princípios</span>
        <h2 class="section-title">Meu jeito de resolver.</h2>
      </div>
    </div>

    <div class="cards-grid three">
      {pilares.map((p, i) => (
        <article class="principle-card">
          <div class="card-top">
            <span class="card-index">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="env secao">
    <div class="section-head">
      <div>
        <span class="rotulo">03 · artigos</span>
        <h2 class="section-title">Ideias que viraram método.</h2>
      </div>
      <a class="botao vazado" href="/artigos/">ver todos</a>
    </div>

    <div class="lista-artigos">
      {artigos.map((a) => (
        <article class="artigo-linha">
          <time datetime={a.data.data.toISOString()}>{fmt(a.data.data)}</time>
          <a href={"/artigos/" + a.id + "/"}>
            <h2>{a.data.titulo}</h2>
            <p>{a.data.resumo}</p>
          </a>
          <a class="artigo-arrow" href={"/artigos/" + a.id + "/"} aria-label={"Ler " + a.data.titulo}>↗</a>
        </article>
      ))}
    </div>
  </section>

  <Chamada titulo="Tem uma vaga, projeto ou problema interessante?" />
</Base>
