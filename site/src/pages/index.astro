---
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import { perfil, pilares, areas, casos } from "../dados/perfil";
import { getCollection } from "astro:content";

const artigos = (await getCollection("artigos", ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data - a.data.data)
  .slice(0, 3);

const fmt = (d) =>
  d.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
---
<Base titulo={perfil.nome + " · marketing, tecnologia e IA"}>
  <section class="env abertura hero">
    <p class="rotulo">{perfil.cargo} · {perfil.local}</p>
    <h1 class="linha-um">Marketing × tecnologia × IA.</h1>
    <p class="resumo">
      Eu transformo problemas de marketing em estratégia, conteúdo e soluções
      digitais. Gosto de descobrir o que o dado está dizendo — e construir o
      que falta para fazer alguma coisa acontecer.
    </p>

    <div class="hero-acoes" aria-label="Ações principais">
      <a class="botao" href="#trabalhos">ver trabalhos</a>
      <a class="botao vazado" href="/sobre/">conhecer meu trabalho</a>
    </div>
  </section>

  <section class="env secao">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">01 · como eu penso</span>
        <p>Menos ferramenta pela ferramenta. Mais contexto.</p>
      </div>

      <div class="itens">
        {pilares.map((p) => (
          <article class="item">
            <h2>{p.titulo}</h2>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="env secao forte" id="trabalhos">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">02 · o que eu faço</span>
        <p>Quatro frentes que se cruzam no trabalho real.</p>
      </div>

      <div class="itens">
        {areas.map((a) => (
          <article class="item">
            <h2>{a.titulo}</h2>
            <p>{a.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="env secao">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">03 · trabalhos selecionados</span>
        <p>Experiência profissional, projetos paralelos e experimentos.</p>
      </div>

      <div class="itens">
        {casos.map((c, i) => (
          <article class="item case-item">
            <div class="case-meta">
              <span class="case-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="rotulo">{c.categoria}</span>
            </div>
            <h2>{c.titulo}</h2>
            <p class="case-papel">{c.papel}</p>
            <p>{c.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="env secao">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">04 · escrevo e testo</span>
        <p>Ideias que nasceram de problemas reais.</p>
      </div>

      <div class="lista-artigos">
        {artigos.map((a) => (
          <article class="artigo-linha">
            <time datetime={a.data.data.toISOString()}>{fmt(a.data.data)}</time>
            <a href={"/artigos/" + a.id + "/"}>
              <h2>{a.data.titulo}</h2>
              <p>{a.data.resumo}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Chamada titulo="Tem uma vaga, projeto ou problema interessante?" />
</Base>
