---
import Base from "../layouts/Base.astro";
import Chamada from "../components/Chamada.astro";
import { perfil } from "../dados/perfil";
---
<Base
  titulo={"Sobre · " + perfil.nome}
  descricao="Trajetória, formação e como Renan Barbosa conecta marketing, tecnologia e IA."
>
  <section class="env abertura">
    <span class="rotulo">02 · sobre</span>
    <h1 class="linha-um">Marketing de um lado. Tecnologia do outro. Eu trabalho no meio.</h1>
    <p class="resumo">Meu foco está em transformar problemas de marketing em estratégia, conteúdo e soluções digitais.</p>
  </section>

  <section class="env secao">
    <div class="section-head">
      <div>
        <span class="rotulo">trajetória</span>
        <h2 class="section-title">Experiência + repertório técnico.</h2>
      </div>
    </div>

    <div class="cards-grid three">
      <article class="principle-card">
        <div class="card-top"><span class="card-index">01</span></div>
        <h3>Marketing</h3>
        <p>SEO, conteúdo, WordPress, Search Console, Analytics e estratégia digital.</p>
      </article>
      <article class="principle-card">
        <div class="card-top"><span class="card-index">02</span></div>
        <h3>IA</h3>
        <p>LLMs, prompting, automação, agentes e experimentação com IA generativa.</p>
      </article>
      <article class="principle-card">
        <div class="card-top"><span class="card-index">03</span></div>
        <h3>Web</h3>
        <p>HTML, CSS, JavaScript, React, Astro, Next.js, GitHub, Vercel e Supabase.</p>
      </article>
    </div>
  </section>

  <section class="env secao">
    <div class="trilho">
      <div class="cabeca">
        <span class="rotulo">formação</span>
        <p>Base de negócio + repertório digital.</p>
      </div>
      <div class="itens">
        <article class="item">
          <h3>Propaganda e Marketing</h3>
          <p>Formação em comunicação, marketing e estratégia.</p>
        </article>
        <article class="item">
          <h3>Pós-graduação em Marketing</h3>
          <p>Estratégias, Negócios Digitais e Experiência do Cliente · PUC Campinas + PUCPR.</p>
        </article>
        <article class="item">
          <h3>Aprendizado pela prática</h3>
          <p>A parte técnica cresceu junto dos problemas reais: sites, automações, protótipos e experimentos.</p>
        </article>
      </div>
    </div>
  </section>

  <Chamada titulo="Quer conversar sobre uma vaga, parceria ou projeto?" />
</Base>
