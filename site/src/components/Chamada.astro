---
import { perfil } from "../dados/perfil";

const {
  titulo = "Precisa de alguém que conecte marketing e tecnologia?",
} = Astro.props;
---
<div class="env">
  <div class="chamada">
    <div>
      <p class="rotulo">vamos conversar</p>
      <h2>{titulo}</h2>
    </div>

    <div class="acoes">
      <a class="botao" href={"mailto:" + perfil.email}>mandar e-mail</a>
      <a
        class="botao vazado"
        href={perfil.linkedin}
        rel="noopener noreferrer"
      >
        linkedin
      </a>
    </div>
  </div>
</div>
